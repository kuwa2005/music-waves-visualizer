# 静的書き出し（/visualizer）を本番配信する場合の例
# 実際のファイル名は .env.production にコピーして使うか、CI で export してください。
#
# 公開例: https://lil.la/visualizer/
# 次の一発コマンドで canonical / og:url / og:image が絶対 URL になります。
#
#   npm run build:html:lil-la
#
# 末尾スラッシュは付けないでください（実装側で正規化します）。

NEXT_PUBLIC_SITE_URL=https://lil.la
NEXT_PUBLIC_ASSET_BASE_PATH=/visualizer
