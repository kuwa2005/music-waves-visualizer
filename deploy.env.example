# （任意）deploy-ftp.sh の埋め込み設定を上書きするときだけ使います。
# 通常は deploy-ftp.sh 先頭の FTP_SERVER / FTP_USER / FTP_PASS / FTP_REMOTE_PATH を編集してください。
#
# 使う場合: cp deploy.env.example deploy.env して編集（deploy.env は .gitignore）

# FTP_SERVER=ftp.example.com
# FTP_USER=your_account
# FTP_PASS=your_password
# FTP_REMOTE_PATH=public_html/visualizer
# LOCAL_DIR=visualizer
# FTP_PASSIVE_MODE=1
# FTP_USE_SSL=0
# BUILD_HTML_TARGET=lil-la
